<?xml version="1.0"?>
<!--
  Ceiling markers: localizer. An indoor robot localizing on ceiling markers
  with an upward webcam, planar mode (x, y, yaw), its fixes fused by the
  robot's state estimator. The robot's own launch runs the camera driver,
  its TF (base_link to the camera) and the estimator (robot_localization),
  which publishes its pose as nav_msgs/Odometry (the gate's prior) and takes
  the fixes on /marker_localizer/pose. Then:

    ros2 launch examples/ceiling/launch/localizer.launch.xml marker_map:=$PWD/sites/my_site/marker_map.yaml

  roll_pitch tf reads the robot's tilt from TF odom -> base_link (an
  estimator fusing an IMU); on a flat floor without one, zero.

  The simulated recording of docs/integration.md plays into this file with
  image_topic:=/camera/image camera_info_topic:=/camera/camera_info
  prior_topic:=/prior_pose prior_type:=pose use_sim_time:=true process_all:=true.
-->
<launch>
  <arg name="marker_map" description="the site's marker_map.yaml"/>
  <arg name="image_topic" default="/ceiling_camera/image_raw"/>
  <arg name="camera_info_topic" default="/ceiling_camera/camera_info"/>
  <arg name="prior_topic" default="/odometry/filtered" description="the estimator's pose, for the gate; empty: no gate"/>
  <arg name="prior_type" default="odometry" description="odometry (nav_msgs/Odometry) or pose (PoseWithCovarianceStamped)"/>
  <arg name="roll_pitch" default="zero" description="zero, tf (from odom) or imu"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="process_all" default="false" description="true for a recording: every frame, in order"/>

  <include file="$(find-pkg-share marker_localizer)/launch/localizer.launch.xml">
    <arg name="marker_map" value="$(var marker_map)"/>
    <arg name="mode" value="planar"/>
    <arg name="base_frame" value="$(var base_frame)"/>
    <arg name="image_topic" value="$(var image_topic)"/>
    <arg name="camera_info_topic" value="$(var camera_info_topic)"/>
    <arg name="prior_topic" value="$(var prior_topic)"/>
    <arg name="prior_type" value="$(var prior_type)"/>
    <arg name="roll_pitch" value="$(var roll_pitch)"/>
    <arg name="roll_pitch_frame" value="odom"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="process_all" value="$(var process_all)"/>
  </include>
</launch>
