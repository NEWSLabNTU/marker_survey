<?xml version="1.0"?>
<!--
  Wall boards: survey. A vehicle's forward camera whose driver also publishes
  visual-inertial odometry. The driver and the vehicle's TF (base_link to the
  camera) are the robot's own; start them first, then:

    ros2 launch examples/wall_course/launch/survey.launch.xml output_dir:=$PWD/sites/my_course origin_marker:=10

  Driver settings that matter for a survey: a rectified image (camera_info
  without distortion), odometry that never resets or jumps (no loop closure,
  no relocalisation), and the odometry's TF publishing off if the vehicle's
  URDF already places the camera.

  The simulated recording of docs/integration.md plays into this file with
  image_topic:=/camera/image odom_topic:=/odom use_sim_time:=true process_all:=true.
-->
<launch>
  <arg name="output_dir" description="where marker_map.yaml, survey_report.yaml and survey_data.npz are written"/>
  <arg name="origin_marker" description="the board that defines the frame"/>
  <arg name="dictionary" default="DICT_5X5_1000"/>
  <arg name="marker_size" default="0.38" description="[m] edge of the black square, measured"/>
  <arg name="image_topic" default="/camera/image_rect"/>
  <arg name="camera_info_topic" default="/camera/camera_info"/>
  <arg name="odom_topic" default="/camera/odom"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="process_all" default="false" description="true for a recording: every frame, in order"/>

  <include file="$(find-pkg-share marker_survey)/launch/survey.launch.xml">
    <arg name="output_dir" value="$(var output_dir)"/>
    <arg name="dictionary" value="$(var dictionary)"/>
    <arg name="marker_size" value="$(var marker_size)"/>
    <arg name="frame_mode" value="origin_marker"/>
    <arg name="origin_marker" value="$(var origin_marker)"/>
    <arg name="pose_source" value="odometry"/>
    <arg name="odom_topic" value="$(var odom_topic)"/>
    <arg name="base_frame" value="$(var base_frame)"/>
    <arg name="image_topic" value="$(var image_topic)"/>
    <arg name="camera_info_topic" value="$(var camera_info_topic)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="process_all" value="$(var process_all)"/>
  </include>
</launch>
