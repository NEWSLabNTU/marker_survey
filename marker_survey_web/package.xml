<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>marker_survey_web</name>
  <version>0.3.0</version>
  <description>The browser interface: print marker sheets, identify markers from a photo; on the robot, survey the markers, check the map and put it to use.</description>
  <maintainer email="noreply@example.com">marker_survey maintainers</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>marker_survey</exec_depend>
  <exec_depend>marker_localizer</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch_xml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
