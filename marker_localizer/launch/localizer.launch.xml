<?xml version="1.0"?>
<!--
  The marker localizer node alone. The camera driver, the robot's TF
  (base_frame to the camera) and the state estimator come from the robot's own
  launch files; examples/wall_course and examples/ceiling show two setups.

    ros2 launch marker_localizer localizer.launch.xml marker_map:=$PWD/site/marker_map.yaml mode:=planar

  For a recorded bag: use_sim_time:=true process_all:=true, then ros2 bag play BAG clock.
  Switch fixes off and on: ros2 param set /marker_localizer enabled false
-->
<launch>
  <arg name="marker_map" description="the site's marker_map.yaml"/>
  <arg name="mode" default="planar" description="planar (x, y, yaw on a flat floor) or 3d (6-DoF)"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="image_topic" default="/camera/image"/>
  <arg name="camera_info_topic" default="/camera/camera_info"/>
  <arg name="compressed" default="false"/>
  <arg name="pose_topic" default="~/pose" description="output, geometry_msgs/PoseWithCovarianceStamped"/>
  <arg name="prior_topic" default="" description="the state estimator's pose, for the gate; empty: no gate"/>
  <arg name="prior_type" default="pose" description="pose (PoseWithCovarianceStamped) or odometry (nav_msgs/Odometry)"/>
  <arg name="gate_distance" default="1.0" description="[m] fixes farther from the prior are dropped"/>
  <arg name="gate_angle_deg" default="15.0"/>
  <arg name="roll_pitch" default="zero" description="planar: the robot's roll and pitch from zero, tf or imu"/>
  <arg name="roll_pitch_frame" default="" description="roll_pitch tf: a level frame, such as odom"/>
  <arg name="imu_topic" default="/imu"/>
  <arg name="detect_scale" default="1.0" description="under 1: find markers in a downscaled image (large cameras)"/>
  <arg name="process_all" default="false" description="every frame in order, over a reliable subscription (recordings)"/>
  <arg name="use_sim_time" default="false"/>

  <node pkg="marker_localizer" exec="marker_localizer" name="marker_localizer" output="screen">
    <param name="marker_map" value="$(var marker_map)"/>
    <param name="mode" value="$(var mode)"/>
    <param name="base_frame" value="$(var base_frame)"/>
    <param name="image_topic" value="$(var image_topic)"/>
    <param name="camera_info_topic" value="$(var camera_info_topic)"/>
    <param name="compressed" value="$(var compressed)"/>
    <param name="pose_topic" value="$(var pose_topic)"/>
    <param name="prior_topic" value="$(var prior_topic)"/>
    <param name="prior_type" value="$(var prior_type)"/>
    <param name="gate_distance" value="$(var gate_distance)"/>
    <param name="gate_angle_deg" value="$(var gate_angle_deg)"/>
    <param name="roll_pitch" value="$(var roll_pitch)"/>
    <param name="roll_pitch_frame" value="$(var roll_pitch_frame)"/>
    <param name="imu_topic" value="$(var imu_topic)"/>
    <param name="detect_scale" value="$(var detect_scale)"/>
    <param name="process_all" value="$(var process_all)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
